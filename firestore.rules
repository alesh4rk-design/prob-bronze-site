rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function meuUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function meuNegocioId() {
      return meuUsuario().negocioId;
    }

    function ehDono() {
      return logado() && meuUsuario().papel == "dono";
    }

    function ehDoMeuNegocio(negocioId) {
      return logado() && meuNegocioId() == negocioId;
    }

    function ehAdmin() {
      return logado() && request.auth.uid == "uQYLkphlAcaG22YDYCSHaDbpnhy1";
    }

    // Negócios: qualquer visitante logado pode criar (cadastro trial);
    // leitura de UM negócio (vitrine da cliente) é aberta a qualquer logado,
    // mas LISTAR todos só é permitido ao dono do próprio negócio ou ao admin geral.
    match /negocios/{negocioId} {
      allow create: if logado();
      allow get: if ehDoMeuNegocio(negocioId) || logado();
      allow list: if ehDoMeuNegocio(negocioId) || ehAdmin();
      allow update: if ehDoMeuNegocio(negocioId) || ehAdmin();
      allow delete: if false;
    }

    // Usuários: qualquer um do mesmo negócio pode ver a equipe;
    // só o dono cria/edita/remove membros (exceto o próprio perfil)
    match /usuarios/{uid} {
      allow read: if logado() && (
        request.auth.uid == uid || ehDono() || resource.data.negocioId == meuNegocioId()
      );
      allow create: if logado();
      allow update: if request.auth.uid == uid || ehDono();
      allow delete: if ehDono();
    }

    // Coleções operacionais: isoladas por negocioId, dono e recepcionista têm acesso
    match /clientes/{id} {
      allow read: if ehDoMeuNegocio(resource.data.negocioId) ||
        (logado() && resource.data.clienteUid == request.auth.uid);
      allow create: if logado() && (
        request.resource.data.clienteUid == request.auth.uid ||
        ehDoMeuNegocio(request.resource.data.negocioId)
      );
      allow update, delete: if ehDoMeuNegocio(resource.data.negocioId);
    }

    match /cabines/{id} {
      allow read, write: if ehDoMeuNegocio(resource.data.negocioId) ||
        (request.method == "create" && ehDoMeuNegocio(request.resource.data.negocioId));
    }

    match /agendamentos/{id} {
      allow read: if ehDoMeuNegocio(resource.data.negocioId) ||
        (logado() && resource.data.clienteId != null &&
         get(/databases/$(database)/documents/clientes/$(resource.data.clienteId)).data.clienteUid == request.auth.uid);
      allow write: if ehDoMeuNegocio(resource.data.negocioId) ||
        (request.method == "create" && ehDoMeuNegocio(request.resource.data.negocioId));
    }

    match /pacotesSessoes/{id} {
      allow read: if ehDoMeuNegocio(resource.data.negocioId) ||
        (logado() && resource.data.clienteId != null &&
         get(/databases/$(database)/documents/clientes/$(resource.data.clienteId)).data.clienteUid == request.auth.uid);
      allow write: if ehDoMeuNegocio(resource.data.negocioId) ||
        (request.method == "create" && ehDoMeuNegocio(request.resource.data.negocioId));
    }

    // Produtos e financeiro: qualquer um do negócio pode ler/escrever no
    // dia a dia (recepcionista registra pagamento e baixa estoque também)
    match /produtosCabine/{id} {
      allow read, write: if ehDoMeuNegocio(resource.data.negocioId) ||
        (request.method == "create" && ehDoMeuNegocio(request.resource.data.negocioId));
    }

    match /financeiro/{id} {
      allow read, write: if ehDoMeuNegocio(resource.data.negocioId) ||
        (request.method == "create" && ehDoMeuNegocio(request.resource.data.negocioId));
    }

    match /servicos/{id} {
      allow read, write: if ehDoMeuNegocio(resource.data.negocioId) ||
        (request.method == "create" && ehDoMeuNegocio(request.resource.data.negocioId));
    }

    match /cupons/{id} {
      allow read, write: if ehDoMeuNegocio(resource.data.negocioId) ||
        (request.method == "create" && ehDoMeuNegocio(request.resource.data.negocioId));
    }
  }
}
