rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function meuUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function meuNegocioId() {
      return meuUsuario().negocioId;
    }

    function ehDono() {
      return logado() && meuUsuario().papel == "dono";
    }

    function ehDoMeuNegocio(negocioId) {
      return logado() && meuNegocioId() == negocioId;
    }

    function ehAdmin() {
      return logado() && request.auth.uid == "vzgts23koAWeJeJ6ojMVdsLRJkJ3";
    }

    // Distingue equipe (dono/funcionário, tem doc em "usuarios") de uma
    // cliente logada (só tem doc em "clientes", vinculado por clienteUid).
    // Usado pra abrir leitura pra clientes sem abrir também pra funcionário.
    function ehClienteSemCadastroDeEquipe() {
      return logado() && !exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    // Negócios: qualquer visitante logado pode criar (cadastro trial);
    // leitura de UM negócio (vitrine da cliente) é aberta a qualquer logado,
    // mas LISTAR todos só é permitido ao dono do próprio negócio ou ao admin geral.
    match /negocios/{negocioId} {
      // Nasce sempre "pendente" — só o admin aprova pra "trial"/"ativo"
      // (ver update abaixo). Sem essa checagem, dava pra criar direto com
      // status "ativo" e pular a aprovação/pagamento.
      allow create: if logado() && request.resource.data.status == 'pendente';
      allow get: if ehDoMeuNegocio(negocioId) || logado();
      allow list: if ehDoMeuNegocio(negocioId) || ehAdmin();
      allow update: if ehDoMeuNegocio(negocioId) || ehAdmin();
      allow delete: if ehAdmin();
    }

    // Usuários: qualquer um do mesmo negócio pode ver a equipe;
    // só o dono cria/edita/remove membros. Criação tem 3 casos legítimos:
    // (1) dono se autocadastrando (negocioId = próprio uid, papel "dono");
    // (2) funcionário se autocadastrando pelo link de convite (papel
    // "recepcionista", negócio precisa existir de verdade);
    // (3) dono cadastrando um funcionário pra própria equipe (usa uma auth
    // secundária pra não perder a própria sessão, então quem está
    // autenticado na hora do create ainda é o dono, não o novo uid).
    // Sem essas checagens, qualquer conta logada podia criar seu próprio
    // doc em "usuarios" com papel "dono" de um negócio de outra pessoa —
    // e a partir daí enxergar o financeiro dela inteiro.
    match /usuarios/{uid} {
      allow read: if logado() && (
        request.auth.uid == uid || ehDono() || resource.data.negocioId == meuNegocioId()
      );
      allow create: if
        (request.auth.uid == uid && request.resource.data.papel == 'dono' && request.resource.data.negocioId == uid) ||
        (request.auth.uid == uid && request.resource.data.papel == 'recepcionista' &&
          exists(/databases/$(database)/documents/negocios/$(request.resource.data.negocioId))) ||
        (ehDono() && request.resource.data.papel == 'recepcionista' && request.resource.data.negocioId == meuNegocioId());
      // Autoedição removida de propósito: nenhum fluxo do app precisa disso
      // hoje, e permitir abria brecha pra alguém trocar o próprio "papel"
      // pra "dono" e ganhar acesso a dados que não são dela.
      allow update: if ehDono() || ehAdmin();
      allow delete: if ehDono() || ehAdmin();
    }

    // Coleções operacionais: isoladas por negocioId, dono e recepcionista têm acesso
    match /clientes/{id} {
      allow read: if ehDoMeuNegocio(resource.data.negocioId) ||
        (logado() && resource.data.clienteUid == request.auth.uid);
      allow create: if logado() && (
        request.resource.data.clienteUid == request.auth.uid ||
        ehDoMeuNegocio(request.resource.data.negocioId)
      );
      allow update, delete: if ehDoMeuNegocio(resource.data.negocioId);
    }

    // Cabines: leitura aberta a qualquer cliente logada (só pra saber
    // quantas existem, e checar se há vaga no horário escolhido)
    match /cabines/{id} {
      allow read: if ehDoMeuNegocio(resource.data.negocioId) || logado();
      allow write: if ehDoMeuNegocio(resource.data.negocioId) ||
        (request.method == "create" && ehDoMeuNegocio(request.resource.data.negocioId));
    }

    match /agendamentos/{id} {
      // Leitura aberta a qualquer logado: a cliente precisa contar quantos
      // horários já estão ocupados (capacidade de cabines) antes de agendar
      allow read: if ehDoMeuNegocio(resource.data.negocioId) || logado();
      allow create: if ehDoMeuNegocio(request.resource.data.negocioId) ||
        (logado() && request.resource.data.clienteId != null &&
         get(/databases/$(database)/documents/clientes/$(request.resource.data.clienteId)).data.clienteUid == request.auth.uid);
      allow update, delete: if ehDoMeuNegocio(resource.data.negocioId);
    }

    match /pacotesSessoes/{id} {
      allow read: if ehDoMeuNegocio(resource.data.negocioId) ||
        (logado() && resource.data.clienteId != null &&
         get(/databases/$(database)/documents/clientes/$(resource.data.clienteId)).data.clienteUid == request.auth.uid);
      allow write: if ehDoMeuNegocio(resource.data.negocioId) ||
        (request.method == "create" && ehDoMeuNegocio(request.resource.data.negocioId));
    }

    // Produtos e financeiro: qualquer um do negócio pode ler/escrever no
    // dia a dia (recepcionista registra pagamento e baixa estoque também)
    match /produtosCabine/{id} {
      allow read, write: if ehDoMeuNegocio(resource.data.negocioId) ||
        (request.method == "create" && ehDoMeuNegocio(request.resource.data.negocioId));
    }

    match /insumos/{id} {
      allow read, write: if ehDoMeuNegocio(resource.data.negocioId) ||
        (request.method == "create" && ehDoMeuNegocio(request.resource.data.negocioId));
    }

    // Financeiro/Despesas: qualquer um do negócio pode CRIAR (recepcionista
    // registra pagamento na venda, e o restoque de produto/insumo lança
    // despesa automática) — mas só o dono pode LER/editar, já que são
    // informações estratégicas que a funcionária não deve enxergar.
    match /financeiro/{id} {
      allow read, update, delete: if ehDoMeuNegocio(resource.data.negocioId) && ehDono();
      allow create: if ehDoMeuNegocio(request.resource.data.negocioId);
    }

    match /despesas/{id} {
      allow read, update, delete: if ehDoMeuNegocio(resource.data.negocioId) && ehDono();
      allow create: if ehDoMeuNegocio(request.resource.data.negocioId);
    }

    // Horário de funcionamento: coleção própria (não é mais campo do doc
    // "negocios") justamente pra poder restringir a leitura só ao dono,
    // exceto pra clientes logadas, que precisam validar o horário ao agendar.
    match /horariosFuncionamento/{negocioId} {
      allow read: if (ehDoMeuNegocio(negocioId) && ehDono()) || ehClienteSemCadastroDeEquipe();
      allow write: if ehDoMeuNegocio(negocioId) && ehDono();
    }

    // Serviços: leitura aberta a qualquer cliente logada (vitrine pra
    // escolher o que agendar); escrita só de quem é do negócio
    match /servicos/{id} {
      allow read: if ehDoMeuNegocio(resource.data.negocioId) || logado();
      allow write: if ehDoMeuNegocio(resource.data.negocioId) ||
        (request.method == "create" && ehDoMeuNegocio(request.resource.data.negocioId));
    }

    match /cupons/{id} {
      allow read, write: if ehDoMeuNegocio(resource.data.negocioId) ||
        (request.method == "create" && ehDoMeuNegocio(request.resource.data.negocioId));
    }
  }
}
