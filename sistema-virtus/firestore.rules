rules_version = '2';

// Regras de segurança do Firestore para o Sistema Virtus.
// Este projeto Firebase é INDEPENDENTE do usado pelo Pro'Bronze — não
// combine estas regras com o firestore.rules da raiz do repositório.

service cloud.firestore {
  match /databases/{database}/documents {

    // usuarios/{uid}: perfil (pendente | admin | viewer) de cada avaliador.
    // Autocadastro (cadastro.html): a própria pessoa cria seu doc, mas SÓ
    // com perfil "pendente" — não pode se autopromover a admin/viewer na
    // criação. Só um admin existente pode mudar o perfil depois (aprovação),
    // via tela "Solicitações pendentes" no dashboard.
    match /usuarios/{uid} {
      allow read: if request.auth != null &&
                     (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid &&
                       request.resource.data.perfil == 'pendente';
      allow update, delete: if request.auth != null && isAdmin();
    }

    // perguntas/{modulo}: banco de questões por módulo. Não é sensível,
    // mas só administradores podem escrever (usado por seed-perguntas.html).
    // Leitura liberada mesmo sem login, pois o candidato faz o quiz sem
    // estar autenticado (ver decisão abaixo sobre `resultados`/`violacoes`).
    match /perguntas/{modulo} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    // resultados/{id}: um documento por tentativa de quiz ou teste de
    // digitação.
    // DECISÃO: a escrita é liberada para qualquer client (inclusive não
    // autenticado / anônimo), porque o candidato que faz o teste NÃO tem
    // login no sistema — só os avaliadores (admin/viewer) fazem login.
    // Isso reproduz o comportamento do server.pyw original, que aceitava
    // POST /api/finalizar e /api/digitacao sem exigir autenticação do
    // candidato. Se quiser exigir Firebase Auth anônimo antes de escrever,
    // troque a condição de create para `request.auth != null`.
    // Leitura é restrita a admin/viewer (só o dashboard lê).
    // Campos `decisao` / `decisao_por` / `decisao_em`: registram se o
    // avaliador considerou o candidato apto/não apto a ingressar na empresa
    // (definido no dashboard, seletor por linha).
    // Admin e viewer podem decidir, MAS o viewer só consegue tocar nesses
    // três campos — não pode alterar nota, nome, respostas nem apagar nada.
    // Admin pode editar o documento inteiro e excluir.
    match /resultados/{id} {
      allow create: if true;
      allow read: if request.auth != null && isAvaliador();
      allow update: if request.auth != null && (
                      isAdmin() ||
                      (isAvaliador() &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['decisao', 'decisao_por', 'decisao_em']))
                    );
      // Excluir candidato: liberado para admin E viewer (decisão do dono do
      // sistema — diferente da edição parcial acima, aqui qualquer avaliador
      // logado pode apagar o resultado inteiro).
      allow delete: if request.auth != null && isAvaliador();
    }

    // codigos_acesso/{codigo}: código de uso único que impede o candidato de
    // fazer o teste em casa. Qualquer avaliador (admin OU viewer) gera um
    // código novo presencialmente e entrega para o candidato ali na hora.
    // - O ID do documento é o próprio código (ex: "384720"), gerado no client.
    // - `get` (leitura de UM documento específico, por ID) é liberado sem
    //   login, pois é assim que o candidato confere se o código existe e
    //   ainda não foi usado. `list` (listar TODOS os códigos) continua
    //   restrito a avaliadores — assim ninguém consegue "descobrir" códigos
    //   válidos sem já saber qual é.
    // - `create` só por avaliador autenticado (geração do código).
    // - `update`: um avaliador pode alterar livremente (ex: cancelar um
    //   código). Um candidato anônimo só pode fazer a transição de
    //   usado:false -> usado:true, e só pode tocar nos campos usado/usado_em
    //   — não dá para "desmarcar" um código usado nem alterar outros campos.
    //   Isso é o que garante o uso único: a segunda tentativa de consumir o
    //   mesmo código encontra usado:true no servidor e a escrita é negada.
    match /codigos_acesso/{codigo} {
      allow get: if true;
      allow list: if request.auth != null && isAvaliador();
      allow create: if request.auth != null && isAvaliador();
      allow update: if (request.auth != null && isAvaliador()) || (
                      resource.data.usado == false &&
                      request.resource.data.usado == true &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usado', 'usado_em'])
                    );
      allow delete: if request.auth != null && isAdmin();
    }

    // violacoes/{id}: mesma lógica de `resultados` — escrita liberada
    // (evento de anti-fraude reportado durante o teste do candidato),
    // leitura restrita aos avaliadores.
    match /violacoes/{id} {
      allow create: if true;
      allow update, delete: if request.auth != null && isAdmin();
      allow read: if request.auth != null && isAvaliador();
    }

    function isAdmin() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil == 'admin';
    }

    function isAvaliador() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'viewer'];
    }
  }
}
