rules_version = '2';

// Regras de segurança do Firestore para o Sistema Virtus.
// Este projeto Firebase é INDEPENDENTE do usado pelo Pro'Bronze — não
// combine estas regras com o firestore.rules da raiz do repositório.
//
// Hierarquia de perfis:
//   - admin / gerência: acesso total. São os únicos que cadastram/aprovam
//     os demais perfis (gerenciam a coleção `usuarios`) e os únicos que
//     mexem no banco de perguntas e nos pesos do Score Virtus.
//   - avaliador / coordenador: mesmo nível de acesso ao processo seletivo —
//     Dashboard completo, decidem sobre candidatos (aprovar, entrevistar,
//     banco de reserva, contratar/recusar, excluir). Não mexem em Usuários,
//     Perguntas nem Pesos (isso é só admin/gerência).
//   - viewer (exibido como "Operador" na tela): só-leitura de verdade —
//     acompanha candidatos, violações e participantes, mas não decide nada
//     sobre eles. A única escrita que continua liberada pra ele é código de
//     acesso/QR Code — é quem opera fisicamente o dia da prova, gerando o
//     código pros candidatos, não uma exceção ao "só visualiza".

service cloud.firestore {
  match /databases/{database}/documents {

    // usuarios/{uid}: perfil (pendente | admin | gerencia | avaliador |
    // viewer | coordenador) de cada pessoa.
    // Autocadastro (cadastro.html): a própria pessoa cria seu doc, mas SÓ
    // com perfil "pendente" — não pode se autopromover na criação.
    // Só admin/gerência aprovam solicitações e gerenciam contas (cadastram
    // coordenadores, avaliadores e views) — avaliador e viewer não mexem
    // nessa coleção.
    match /usuarios/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isGerencia());
      allow create: if request.auth != null && request.auth.uid == uid &&
                       request.resource.data.perfil == 'pendente';
      // Só Admin pode conceder o perfil "gerencia" (ou "admin") — Gerência
      // aprova/promove todo o resto (avaliador, viewer, coordenador), mas
      // nunca cria outro Gerente. Ver dashboard.html (renderPendentes):
      // pedidos marcados "solicita_gerente" só aparecem pro Admin.
      allow update: if request.auth != null && (
        isAdmin() ||
        (isGerencia() && !(request.resource.data.perfil in ['admin', 'gerencia']))
      );
      allow delete: if request.auth != null && isGerencia();
    }

    // perguntas/{modulo}: banco de questões por módulo, COM o gabarito
    // (campo `resposta`) de cada questão. Antes essa coleção era pública
    // (allow read: if true) porque o candidato lia direto daqui para montar
    // o quiz — mas isso deixava o gabarito de todas as questões acessível
    // via DevTools/REST API, sem precisar nem abrir o site. Agora o
    // candidato nunca lê essa coleção diretamente: o Worker (Cloudflare)
    // busca as perguntas usando uma conta de serviço (que ignora estas
    // regras) e só manda pro navegador o que ele pode ver, sem `resposta`.
    // Leitura e escrita ficam restritas a admin/gerência.
    match /perguntas/{modulo} {
      allow read, write: if request.auth != null && isGerencia();
    }

    // resultados/{id}: um documento por tentativa de quiz ou teste de
    // digitação.
    // Testes de digitação (`tipo == 'typing'`) continuam sendo gravados
    // direto pelo navegador do candidato (sem login) — não têm gabarito
    // secreto, o risco de fabricar um resultado é baixo.
    // Resultados de quiz (`tipo == 'quiz'`) NÃO podem mais ser criados
    // direto pelo navegador do candidato: a correção acontece no Worker
    // (Cloudflare), que grava o resultado usando uma conta de serviço que
    // ignora estas regras. Isso impede alguém de gravar uma nota fabricada
    // direto no Firestore sem nunca ter feito o teste de verdade.
    // Leitura: qualquer perfil aprovado (inclusive view, que usa isso pra
    // ver a lista de participantes, e coordenador, que acompanha o funil).
    match /resultados/{id} {
      allow create: if request.resource.data.tipo == 'typing';
      allow read: if request.auth != null && isLeitor();
      allow update: if request.auth != null && isGerencia();
      // Excluir candidato: liberado pra quem gerencia o processo seletivo
      // (admin/gerência/avaliador/coordenador) — Operador (viewer) NÃO
      // exclui mais: ele só acompanha, não decide nem apaga nada.
      allow delete: if request.auth != null && isGerenciaCandidatos();
    }

    // codigos_acesso/{codigo}: código COMPARTILHADO que impede o candidato de
    // fazer o teste em casa. Qualquer um da equipe operacional gera um
    // código único por entrevista/dia — o MESMO código serve para todos os
    // candidatos (não é de uso único), pensado para dias com muita gente
    // (20+ candidatos). Expira sozinho 4h depois de gerado (campo
    // `expira_em`), validado aqui no SERVIDOR via request.time — por isso um
    // candidato não consegue continuar usando um código vencido nem
    // adiantando/atrasando o relógio do próprio celular.
    // - O ID do documento é o próprio código (ex: "384720"), gerado no client.
    // - A checagem do código pelo candidato NÃO passa mais direto pelo
    //   Firestore: vai pelo Worker (Cloudflare), que aplica um limite de
    //   tentativas por IP antes de consultar aqui com uma conta de serviço
    //   (que ignora estas regras). Antes, `get`/`update` eram públicos e
    //   davam pra tentar adivinhar o código por força bruta direto na API
    //   do Firestore, sem passar pelo Worker nem pelo site.
    // Operador (viewer) continua podendo gerar/desativar — é literalmente o
    // trabalho dele no dia da prova, não uma decisão sobre candidato.
    match /codigos_acesso/{codigo} {
      allow get, list, create, update, delete: if request.auth != null && isOperacional();
    }

    // config/{doc}: configurações gerais do sistema (ex: número de WhatsApp
    // do RH, usado para o candidato avisar que terminou a avaliação). Não é
    // sensível — leitura liberada mesmo sem login, pois o candidato precisa
    // ler o número pra montar o link do WhatsApp. Escrita pela equipe.
    match /config/{doc} {
      allow read: if true;
      allow write: if request.auth != null && isOperacional();
    }

    // config_pesos/pesos: pesos do Score Virtus (por cargo + um padrão pra
    // quem não tem override). Coleção separada de `config` de propósito —
    // aqui a leitura já exige login (o score é informação interna do
    // processo seletivo, não como o número de WhatsApp) e a escrita é mais
    // restrita: só admin/gerência configura os pesos, o resto da equipe só
    // vê o resultado calculado.
    match /config_pesos/{doc} {
      allow read: if request.auth != null && isLeitor();
      allow write: if request.auth != null && isGerencia();
    }

    // vagas/{id}: vaga de processo seletivo (cargo, local, quantidade,
    // status aberta/encerrada). Leitura pública igual `config` — o
    // candidato precisa ver as vagas abertas na ficha ANTES de fazer
    // login (ele nunca tem conta no sistema). Escrita fica com quem
    // gerencia candidatos: admin/gerência/avaliador/coordenador — mesmo
    // grupo que já mexe no pipeline dos candidatos.
    match /vagas/{id} {
      allow read: if true;
      allow write: if request.auth != null &&
                     exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
                     get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'gerencia', 'avaliador', 'coordenador'];
    }

    // violacoes/{id}: escrita liberada sem login (evento de anti-fraude
    // reportado durante o teste do candidato, que não tem conta no sistema),
    // mas com validação básica de formato/tamanho pra impedir spam de
    // documentos falsos ou payloads gigantes inflando a conta do Firestore.
    // Leitura: view precisa ver (faz parte do escopo dele), então qualquer
    // perfil aprovado lê.
    match /violacoes/{id} {
      allow create: if request.resource.data.nome is string &&
                       request.resource.data.nome.size() < 120 &&
                       request.resource.data.modulo is string &&
                       request.resource.data.modulo.size() < 80 &&
                       request.resource.data.tipo is string &&
                       request.resource.data.tipo.size() < 60 &&
                       (!('detalhe' in request.resource.data) ||
                        (request.resource.data.detalhe is string &&
                         request.resource.data.detalhe.size() < 300));
      allow update, delete: if request.auth != null && isGerencia();
      allow read: if request.auth != null && isLeitor();
    }

    // pipeline/{chave}: etapa do processo seletivo de cada candidato
    // (Aguardando | Entrevista | Contratado | Recusado), observação do
    // avaliador, aprovação manual (aba "Aprovados") e banco de reserva.
    // Isso é DIFERENTE da nota do teste — não mexe na prova, é só controle
    // de processo de contratação/decisão da equipe.
    // Leitura: qualquer perfil aprovado (inclusive view, que só enxerga a
    // aba Banco de Reserva com esses dados — Candidatos, Aprovados e
    // Contratados continuam escondidos dele no client). Escrita continua
    // restrita a quem gerencia/aprova: admin/gerência/avaliador/coordenador.
    match /pipeline/{chave} {
      allow read: if request.auth != null && isLeitor();
      allow write: if request.auth != null &&
                     exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
                     get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'gerencia', 'avaliador', 'coordenador'];

      // pipeline/{chave}/historico/{id}: trilha de auditoria — uma entrada
      // por mudança de etapa (quem mudou, quando, pra qual etapa). NUNCA é
      // sobrescrita nem apagada, nem por quem tem permissão de escrever no
      // documento pai: um doc novo por mudança, pra nenhuma decisão
      // importante "desaparecer" quando alguém muda de ideia depois.
      match /historico/{id} {
        allow read: if request.auth != null && isLeitor();
        allow create: if request.auth != null && isGerenciaCandidatos();
        allow update, delete: if false;
      }

      // pipeline/{chave}/comentarios/{id}: comentários da equipe sobre o
      // candidato — mesmo espírito do histórico (um doc novo por
      // comentário, nunca editado/apagado), pra sempre dar pra ver quem
      // escreveu o quê e quando, em vez de um campo único reescrito por
      // cima a cada edição.
      match /comentarios/{id} {
        allow read: if request.auth != null && isLeitor();
        allow create: if request.auth != null && isGerenciaCandidatos();
        allow update, delete: if false;
      }
    }

    // Só admin — o único que pode conceder o perfil "gerencia" a alguém
    // (ver regra de update de usuarios/{uid} acima).
    function isAdmin() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil == 'admin';
    }

    // Acesso total (admin ou gerência) — únicos que mexem em usuários,
    // perguntas e pesos do Score Virtus.
    function isGerencia() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'gerencia'];
    }

    // Quem gerencia o processo seletivo de verdade (decide sobre
    // candidatos) — admin, gerência, avaliador e coordenador têm todos o
    // MESMO nível de acesso aqui, de propósito: só o Operador (viewer) fica
    // de fora, porque ele só acompanha, não decide.
    function isGerenciaCandidatos() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'gerencia', 'avaliador', 'coordenador'];
    }

    // Equipe operacional (todo mundo aprovado, inclusive Operador) — usada
    // só pra tarefas que não são "decisão sobre candidato": código de
    // acesso, config geral.
    function isOperacional() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'gerencia', 'avaliador', 'viewer', 'coordenador'];
    }

    // Qualquer perfil aprovado — leitura de resultados/violações/pipeline,
    // que todo mundo (inclusive Operador) precisa ver.
    function isLeitor() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'gerencia', 'avaliador', 'viewer', 'coordenador'];
    }
  }
}
