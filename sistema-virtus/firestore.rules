rules_version = '2';

// Regras de segurança do Firestore para o Sistema Virtus.
// Este projeto Firebase é INDEPENDENTE do usado pelo Pro'Bronze — não
// combine estas regras com o firestore.rules da raiz do repositório.
//
// Hierarquia de perfis:
//   - admin / gerência: acesso total. São os únicos que cadastram/aprovam
//     coordenadores, avaliadores e views (gerenciam a coleção `usuarios`) e
//     os únicos que mexem no banco de perguntas.
//   - avaliador: "chefe" dos views — tudo que o view tem, mais Dashboard
//     completo, Banco de Aprovados e Processo Seletivo (envia candidatos
//     pro coordenador/RH e acompanha o funil de contratação).
//   - viewer (o "view" do sistema): acesso restrito a QR Codes, Código de
//     Acesso, Violações e a lista de participantes (resultados dos testes).
//     Não mexe em Perguntas, Usuários nem no Processo Seletivo.
//   - coordenador: só-leitura, vê a lista de candidatos (Processo Seletivo)
//     pra acompanhar o processo, sem mexer em nada.

service cloud.firestore {
  match /databases/{database}/documents {

    // usuarios/{uid}: perfil (pendente | admin | gerencia | avaliador |
    // viewer | coordenador) de cada pessoa.
    // Autocadastro (cadastro.html): a própria pessoa cria seu doc, mas SÓ
    // com perfil "pendente" — não pode se autopromover na criação.
    // Só admin/gerência aprovam solicitações e gerenciam contas (cadastram
    // coordenadores, avaliadores e views) — avaliador e viewer não mexem
    // nessa coleção.
    match /usuarios/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isGerencia());
      allow create: if request.auth != null && request.auth.uid == uid &&
                       request.resource.data.perfil == 'pendente';
      allow update, delete: if request.auth != null && isGerencia();
    }

    // perguntas/{modulo}: banco de questões por módulo, COM o gabarito
    // (campo `resposta`) de cada questão. Antes essa coleção era pública
    // (allow read: if true) porque o candidato lia direto daqui para montar
    // o quiz — mas isso deixava o gabarito de todas as questões acessível
    // via DevTools/REST API, sem precisar nem abrir o site. Agora o
    // candidato nunca lê essa coleção diretamente: o Worker (Cloudflare)
    // busca as perguntas usando uma conta de serviço (que ignora estas
    // regras) e só manda pro navegador o que ele pode ver, sem `resposta`.
    // Leitura e escrita ficam restritas a admin/gerência.
    match /perguntas/{modulo} {
      allow read, write: if request.auth != null && isGerencia();
    }

    // resultados/{id}: um documento por tentativa de quiz ou teste de
    // digitação.
    // Testes de digitação (`tipo == 'typing'`) continuam sendo gravados
    // direto pelo navegador do candidato (sem login) — não têm gabarito
    // secreto, o risco de fabricar um resultado é baixo.
    // Resultados de quiz (`tipo == 'quiz'`) NÃO podem mais ser criados
    // direto pelo navegador do candidato: a correção acontece no Worker
    // (Cloudflare), que grava o resultado usando uma conta de serviço que
    // ignora estas regras. Isso impede alguém de gravar uma nota fabricada
    // direto no Firestore sem nunca ter feito o teste de verdade.
    // Leitura: qualquer perfil aprovado (inclusive view, que usa isso pra
    // ver a lista de participantes, e coordenador, que acompanha o funil).
    match /resultados/{id} {
      allow create: if request.resource.data.tipo == 'typing';
      allow read: if request.auth != null && isLeitor();
      allow update: if request.auth != null && isGerencia();
      // Excluir candidato: liberado pra equipe operacional (admin/gerência/
      // avaliador/viewer) — coordenador NÃO pode excluir, só acompanha.
      allow delete: if request.auth != null && isEquipe();
    }

    // codigos_acesso/{codigo}: código COMPARTILHADO que impede o candidato de
    // fazer o teste em casa. Qualquer um da equipe (admin/gerência/avaliador/
    // viewer) gera um código único por entrevista/dia — o MESMO código serve
    // para todos os candidatos (não é de uso único), pensado para dias com
    // muita gente (20+ candidatos). Expira sozinho 4h depois de gerado
    // (campo `expira_em`), validado aqui no SERVIDOR via request.time — por
    // isso um candidato não consegue continuar usando um código vencido nem
    // adiantando/atrasando o relógio do próprio celular.
    // - O ID do documento é o próprio código (ex: "384720"), gerado no client.
    // - A checagem do código pelo candidato NÃO passa mais direto pelo
    //   Firestore: vai pelo Worker (Cloudflare), que aplica um limite de
    //   tentativas por IP antes de consultar aqui com uma conta de serviço
    //   (que ignora estas regras). Antes, `get`/`update` eram públicos e
    //   davam pra tentar adivinhar o código por força bruta direto na API
    //   do Firestore, sem passar pelo Worker nem pelo site.
    match /codigos_acesso/{codigo} {
      allow get, list, create, update, delete: if request.auth != null && isEquipe();
    }

    // config/{doc}: configurações gerais do sistema (ex: número de WhatsApp
    // do RH, usado para o candidato avisar que terminou a avaliação). Não é
    // sensível — leitura liberada mesmo sem login, pois o candidato precisa
    // ler o número pra montar o link do WhatsApp. Escrita pela equipe.
    match /config/{doc} {
      allow read: if true;
      allow write: if request.auth != null && isEquipe();
    }

    // violacoes/{id}: escrita liberada sem login (evento de anti-fraude
    // reportado durante o teste do candidato, que não tem conta no sistema),
    // mas com validação básica de formato/tamanho pra impedir spam de
    // documentos falsos ou payloads gigantes inflando a conta do Firestore.
    // Leitura: view precisa ver (faz parte do escopo dele), então qualquer
    // perfil aprovado lê.
    match /violacoes/{id} {
      allow create: if request.resource.data.nome is string &&
                       request.resource.data.nome.size() < 120 &&
                       request.resource.data.modulo is string &&
                       request.resource.data.modulo.size() < 80 &&
                       request.resource.data.tipo is string &&
                       request.resource.data.tipo.size() < 60 &&
                       (!('detalhe' in request.resource.data) ||
                        (request.resource.data.detalhe is string &&
                         request.resource.data.detalhe.size() < 300));
      allow update, delete: if request.auth != null && isGerencia();
      allow read: if request.auth != null && isLeitor();
    }

    // pipeline/{chave}: etapa do processo seletivo de cada candidato
    // (Aguardando | Entrevista | Contratado | Recusado), observação do
    // avaliador e marcação de "visível ao RH". Isso é DIFERENTE da nota do
    // teste — não reintroduz decisão manual sobre a prova, é só controle de
    // processo de contratação.
    // View NÃO tem acesso ao Processo Seletivo (nem leitura). Quem
    // gerencia é admin/gerência/avaliador; coordenador só lê.
    match /pipeline/{chave} {
      allow read: if request.auth != null &&
                     exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
                     get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'gerencia', 'avaliador', 'coordenador'];
      allow write: if request.auth != null &&
                      exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'gerencia', 'avaliador'];
    }

    // Acesso total (admin ou gerência) — únicos que mexem em usuários e
    // perguntas.
    function isGerencia() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'gerencia'];
    }

    // Equipe operacional (admin, gerência, avaliador, viewer) — QR Codes,
    // Código de Acesso, exclusão de resultados etc.
    function isEquipe() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'gerencia', 'avaliador', 'viewer'];
    }

    // Qualquer perfil aprovado (inclusive coordenador) — leitura de
    // resultados/violações, que view e coordenador também precisam ver.
    function isLeitor() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil in ['admin', 'gerencia', 'avaliador', 'viewer', 'coordenador'];
    }
  }
}
